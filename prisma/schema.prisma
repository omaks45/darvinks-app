
// TB DARVINKS — Complete Schema (All Phases)
// ORM: Prisma | DB: Neon (PostgreSQL)

generator client {
  provider   = "prisma-client-js"
  previewFeatures = ["driverAdapters"]

}

datasource db {
  provider = "postgresql"
}



// ═════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═════════════════════════════════════════════════════════════════════════════

enum UserTier {
  TIER1                // Merchandiser / Promoter / DBSR / VSR
  TIER2                // Sales Representative / SSR
  TIER3                // ATSM / TSM
  TIER4                // Zonal Sales Manager
  TIER5_SALES_HEAD
  TIER5_SALES_SUPPORT  // Formerly System Admin — approves POs, manages users, uploads product images
  TIER5_FIELD_SUPPORT  // New — oversees attendance, KD visits, customers (primary & secondary)
  TIER6_GM
  WAREHOUSE_ADMIN
}

enum UserRole {
  // Tier 1
  MERCHANDISER
  PROMOTER
  DBSR
  VSR
  // Tier 2
  SALES_REPRESENTATIVE
  SSR
  // Tier 3
  ATSM
  TSM
  // Tier 4
  ZONAL_SALES_MANAGER
  // Tier 5
  SALES_HEAD
  SALES_SUPPORT
  FIELD_SUPPORT
  WAREHOUSE_ADMIN
  // Tier 6
  GENERAL_MANAGER
}

// Describes how an account was created.
// SELF_REGISTERED — field staff (Tiers 1–4) registered themselves via the app
// PROVISIONED     — back-office staff created by System Admin via admin panel
enum AccountOrigin {
  SELF_REGISTERED
  PROVISIONED
}

enum Team {
  BRIGHT
  RADIANT
}

enum Region {
  // Team Bright
  NORTH_BRIGHT
  SS1
  SS2
  SS3
  SE1
  // Team Radiant
  LAGOS_1
  LAGOS_2
  NORTH_CENTRAL
  NORTH_WEST
  SOUTH_WEST
  MODERN_TRADE
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
  KD_VISIT
  KD_VISIT_END
}

enum AttendanceFlag {
  ON_TIME
  LATE
  MISSED
  OUTSIDE_WINDOW
}

enum ProductCategory {
  CREAM
  SOAP
  LOTION
  MAINTENANCE
}

enum LotionUnit {
  PIECE
  ROW
  CARTON
}

enum WarehouseLocation {
  LAGOS_HQ
  ONITSHA
  KANO
}

enum StockMovementType {
  INBOUND
  OUTBOUND_PO
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  PENDING_APPROVAL
  APPROVED
  PAYMENT_RECEIVED
  DO_UPLOADED
  DELIVERED
  FULLY_PAID
  DEFAULTED
  CANCELLED
}

enum InvoiceQualification {
  PENDING
  QUALIFIED
  NOT_QUALIFIED
}

enum PaymentMode {
  CASH
  TRANSFER
  CHEQUE
}

enum BuyerType {
  SUB_DISTRIBUTOR
  WHOLESALER
  RETAILER
}

enum CompetitorReportMediaType {
  PDF
  IMAGE
  VIDEO
  TEXT
}

enum NotificationChannel {
  FCM
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TargetPeriod {
  ANNUAL
  QUARTERLY
  MONTHLY
  WEEKLY
}

enum CustomerType {
  PRIMARY    // KD — receives from org
  SECONDARY  // Sells to end market
}

enum SecondaryCustomerType {
  SUB_DISTRIBUTOR
  WHOLESALER
  RETAILER
}

enum StockCollectionStatus {
  DRAFT
  CONFIRMED
}

enum SecondaryInvoiceStatus {
  UNPAID
  PARTIAL
  SETTLED
}

enum LedgerStatus {
  UNPAID
  PARTIAL
  SETTLED
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 1 — AUTH, USERS, ATTENDANCE
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id                 String             @id @default(uuid())
  employeeRef        String             @unique
  fullName           String
  email              String             @unique
  phone              String             @unique
  passwordHash       String

  // Role + tier (tier is derived from role at registration)
  role               UserRole
  roleLabel          String
  tier               UserTier

  // Account type
  accountOrigin      AccountOrigin      @default(SELF_REGISTERED)
  mustChangePassword Boolean            @default(false)

  // Team / region / state — null for back-office roles
  team               Team?
  region             Region?
  state              String?

  dateOfBirth        DateTime?
  profilePictureUrl  String?
  idCardUrl          String?
  isActive           Boolean            @default(true)
  fcmToken           String?

  // Annual targets stored as JSON: { "LOTION": 500, "SOAP": 300, ... }
  annualTargets      Json               @default("{}")

  // Warehouse Admin scope — only populated for WAREHOUSE_ADMIN
  warehouseLocation  WarehouseLocation?

  // Who provisioned this account (null for self-registered)
  provisionedById    String?
  provisionedBy      User?              @relation("ProvisionedBy", fields: [provisionedById], references: [id])
  provisionedUsers   User[]             @relation("ProvisionedBy")

  reportsToId        String?
  reportsTo          User?              @relation("ReportsTo", fields: [reportsToId], references: [id])
  directReports      User[]             @relation("ReportsTo")

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lastLogoutAt       DateTime?

  // ── Relations ──────────────────────────────────────────────────────────────
  refreshTokens              RefreshToken[]
  attendanceEvents           AttendanceEvent[]
  passwordResets             PasswordResetOtp[]
  purchaseOrdersCreated      PurchaseOrder[]       @relation("POCreatedBy")
  purchaseOrdersApproved     PurchaseOrder[]       @relation("POApprovedBy")
  purchaseOrdersDelivered    PurchaseOrder[]       @relation("PODeliveredBy")
  collections                Collection[]
  secondarySales             SecondarySale[]
  competitorReports          CompetitorReport[]
  notifications              Notification[]
  outOfRegionRequests        OutOfRegionRequest[]  @relation("OORRequestedBy")
  outOfRegionApprovals       OutOfRegionRequest[]  @relation("OORApprovedBy")
  stockMovements             StockMovement[]       @relation("StockMovedBy")
  stockAdjustments           StockMovement[]       @relation("StockAdjustedBy")
  ownedCustomers             Customer[]            @relation("CustomerOwner")
  targetsAssigned            TargetAssignment[]    @relation("AssignedBy")
  targetsReceived            TargetAssignment[]    @relation("AssignedTo")
  invitesSent                InviteToken[]         @relation("InviteCreatedBy")
  locationTargetsCreated     LocationTarget[]      @relation("LocationTargetCreatedBy")
  stockCollections           StockCollection[]
  agentInventory             AgentInventory[]
  secondarySaleInvoices      SecondarySaleInvoice[] @relation("SecondarySaleInvoiceSoldBy")
  kdPayments                 KdPayment[]            @relation("KdPaymentRecorder")
  secondaryPayments          SecondaryPayment[]     @relation("SecondaryPaymentRecorder")

  @@index([tier])
  @@index([role])
  @@index([team])
  @@index([region])
  @@index([email])
  @@index([isActive])
  @@index([accountOrigin])
  @@index([reportsToId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  replacedBy String?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String   // bcrypt hash of the 6-digit OTP — never store plain text
  expiresAt DateTime // 15 minutes from creation
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteToken {
  id                String             @id @default(uuid())
  token             String             @unique
  email             String
  role              UserRole
  team              Team?
  warehouseLocation WarehouseLocation?
  createdById       String
  createdBy         User               @relation("InviteCreatedBy", fields: [createdById], references: [id])
  isUsed            Boolean            @default(false)
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime           @default(now())

  @@index([token])
  @@index([email])
  @@index([createdById])
}

model AttendanceEvent {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AttendanceType
  flag        AttendanceFlag @default(ON_TIME)
  photoUrl    String
  latitude    Float
  longitude   Float
  address     String?
  deviceTime  DateTime
  serverTime  DateTime       @default(now())
  kdAccountId String?
  kdAccount   Customer?      @relation(fields: [kdAccountId], references: [id])
  note        String?

  @@index([userId, serverTime])
  @@index([userId, deviceTime])
  @@index([type])
  @@index([flag])
}

// ─────────────────────────────────────────────────────────────────────────────
// TARGET ASSIGNMENTS
// ─────────────────────────────────────────────────────────────────────────────

model TargetAssignment {
  id            String          @id @default(uuid())
  assignedById  String?
  assignedBy    User?           @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedToId  String
  assignedTo    User            @relation("AssignedTo", fields: [assignedToId], references: [id])
  category      ProductCategory
  period        TargetPeriod    @default(ANNUAL)
  year          Int
  quarter       Int?
  month         Int?
  week          Int?
  targetCartons Int

  parentAssignmentId String?
  parentAssignment   TargetAssignment?  @relation("TargetCascade", fields: [parentAssignmentId], references: [id])
  children           TargetAssignment[] @relation("TargetCascade")

  isStale       Boolean         @default(false)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([assignedToId, category, period, year, quarter, month, week])
  @@index([assignedById])
  @@index([assignedToId])
  @@index([category])
  @@index([year])
  @@index([parentAssignmentId])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — PRODUCTS & SKU CATALOGUE
// ═════════════════════════════════════════════════════════════════════════════

model Product {
  id              String          @id @default(uuid())
  name            String
  category        ProductCategory
  packQty         Int
  unitPriceKobo   BigInt
  cartonPriceKobo BigInt

  // Human-readable label for the selling unit shown on mobile UI.
  // Values: "box" | "roll" | "bottle" | "litre" | "pc"
  // CREAM      → "box"
  // SOAP       → "roll"
  // LOTION     → "roll" (except Cup Cream 250ml → "pc")
  // MAINTENANCE → "roll" | "litre" | "bottle" (per product)
  unitLabel       String          @default("unit")

  isActive        Boolean         @default(true)
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  stockEntries             StockEntry[]
  agentInventory           AgentInventory[]
  purchaseOrderItems       PurchaseOrderItem[]
  secondarySaleItems       SecondarySaleItem[]
  stockMovements           StockMovement[]     @relation("ProductStockMovements")
  stockCollectionItems     StockCollectionItem[]
  secondarySaleInvoiceItems SecondarySaleInvoiceItem[]

  @@unique([name, category])
  @@index([category])
  @@index([isActive])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — CUSTOMERS (KEY DISTRIBUTORS)
// ═════════════════════════════════════════════════════════════════════════════

model Customer {
  id              String    @id @default(uuid())
  businessName    String
  address         String
  mobilePhone     String
  whatsApp        String?
  email           String?
  cacNumber       String?
  contactPerson   String
  contactPhone    String
  contactPosition String?
  region          Region
  state           String
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  isActive        Boolean   @default(true)
  balanceKobo     BigInt    @default(0)
  ownerId         String
  owner           User      @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customerType          CustomerType           @default(PRIMARY)
  secondaryCustomerType SecondaryCustomerType?
  purchaseOrders        PurchaseOrder[]
  collections           Collection[]
  stockCollections      StockCollection[]      @relation("StockCollectionSource")
  attendanceVisits      AttendanceEvent[]
  outOfRegionRequests   OutOfRegionRequest[]
  secondarySales        SecondarySale[]        @relation("SecondarySaleKdAccount")
  secondarySaleInvoices SecondarySaleInvoice[] @relation("SecondarySaleInvoiceCustomer")
  kdLedgerEntries       KdLedgerEntry[]        @relation("KdLedger")

  @@index([ownerId])
  @@index([region])
  @@index([balanceKobo])
  @@index([locationId])
}

model OutOfRegionRequest {
  id          String         @id @default(uuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  requestedBy String
  requester   User           @relation("OORRequestedBy", fields: [requestedBy], references: [id])
  approvedBy  String?
  approver    User?          @relation("OORApprovedBy", fields: [approvedBy], references: [id])
  status      ApprovalStatus @default(PENDING)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — WAREHOUSE
// ═════════════════════════════════════════════════════════════════════════════

model StockEntry {
  id                String            @id @default(uuid())
  warehouseLocation WarehouseLocation
  productId         String
  product           Product           @relation(fields: [productId], references: [id])
  quantityCartons   Int               @default(0)
  lowStockThreshold Int               @default(10)
  updatedAt         DateTime          @updatedAt

  @@unique([warehouseLocation, productId])
  @@index([warehouseLocation])
  @@index([quantityCartons])
}

model StockMovement {
  id                String            @id @default(uuid())
  warehouseLocation WarehouseLocation
  productId         String
  product           Product           @relation("ProductStockMovements", fields: [productId], references: [id])
  type              StockMovementType
  quantityCartons   Int
  batchReference    String?
  reasonNote        String?
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  recordedById      String
  recordedBy        User              @relation("StockMovedBy", fields: [recordedById], references: [id])
  adjustedById      String?
  adjustedBy        User?             @relation("StockAdjustedBy", fields: [adjustedById], references: [id])
  createdAt         DateTime          @default(now())

  @@index([warehouseLocation, createdAt])
  @@index([productId])
  @@index([type])
  @@index([purchaseOrderId])
}

model StockCollection {
  id            String                @id @default(uuid())
  collectionRef String                @unique
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  sourceId      String
  source        Customer              @relation("StockCollectionSource", fields: [sourceId], references: [id])
  status        StockCollectionStatus @default(DRAFT)
  subtotalKobo  BigInt                @default(0)
  note          String?
  invoiceUrl    String?
  submittedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         StockCollectionItem[]

  @@index([userId])
  @@index([sourceId])
  @@index([status])
  @@index([userId, createdAt])
}

model StockCollectionItem {
  id                String          @id @default(uuid())
  stockCollectionId String
  stockCollection   StockCollection @relation(fields: [stockCollectionId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantityCartons   Int
  unitPriceKobo     BigInt
  lineTotalKobo     BigInt
  createdAt         DateTime        @default(now())

  @@index([stockCollectionId])
  @@index([productId])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — PURCHASE ORDERS
// ═════════════════════════════════════════════════════════════════════════════

model PurchaseOrder {
  id                 String               @id @default(uuid())
  orderRef           String               @unique
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id])
  warehouseLocation  WarehouseLocation
  status             PurchaseOrderStatus  @default(PENDING_APPROVAL)
  qualification      InvoiceQualification @default(PENDING)
  subtotalKobo       BigInt
  creditAppliedKobo  BigInt               @default(0)
  totalKobo          BigInt
  paidKobo           BigInt               @default(0)
  cashDiscountKobo   BigInt               @default(0)
  incentiveKobo      BigInt               @default(0)
  kdInvoiceUrl       String?
  chequeUrl          String?
  formalInvoiceUrl   String?
  deliveryOrderUrl   String?
  invoiceMismatch    Json?
  createdById        String
  createdBy          User                 @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?                @relation("POApprovedBy", fields: [approvedById], references: [id])
  deliveredById      String?
  deliveredBy        User?                @relation("PODeliveredBy", fields: [deliveredById], references: [id])
  approvedAt         DateTime?
  deliveredAt        DateTime?
  paymentDeadline    DateTime?
  fullyPaidAt        DateTime?
  note               String?
  approvalReceiptUrl String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items          PurchaseOrderItem[]
  payments       PaymentRecord[]
  stockMovements StockMovement[]
  kdLedgerEntry  KdLedgerEntry?

  @@index([customerId])
  @@index([status])
  @@index([qualification])
  @@index([warehouseLocation])
  @@index([createdById])
  @@index([paymentDeadline])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityCartons Int
  unitPriceKobo   BigInt
  lineTotalKobo   BigInt

  @@index([purchaseOrderId])
  @@index([productId])
}

model PaymentRecord {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amountKobo      BigInt
  paymentMode     PaymentMode
  proofUrl        String?
  note            String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — COLLECTIONS
// ═════════════════════════════════════════════════════════════════════════════

model Collection {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  recordedById  String
  recordedBy    User        @relation(fields: [recordedById], references: [id])
  receiptUrl    String
  amountKobo    BigInt
  paymentMode   PaymentMode
  depositorName String
  location      String
  collectedAt   DateTime
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([recordedById])
  @@index([collectedAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 3 — SECONDARY SALES
// ═════════════════════════════════════════════════════════════════════════════

model SecondarySale {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  kdAccountId String
  kdAccount   Customer            @relation("SecondarySaleKdAccount", fields: [kdAccountId], references: [id])
  latitude    Float
  longitude   Float
  address     String?
  deviceTime  DateTime
  serverTime  DateTime            @default(now())
  note        String?
  createdAt   DateTime            @default(now())
  items       SecondarySaleItem[]

  @@index([userId, deviceTime])
  @@index([kdAccountId])
}

model SecondarySaleItem {
  id              String        @id @default(uuid())
  secondarySaleId String
  secondarySale   SecondarySale @relation(fields: [secondarySaleId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  buyerType       BuyerType
  quantityCartons Int           @default(0)
  quantityRows    Int           @default(0)
  quantityPieces  Int           @default(0)

  @@index([secondarySaleId])
  @@index([productId])
}

model SecondarySaleInvoice {
  id          String                    @id @default(uuid())
  invoiceRef  String                    @unique
  soldById    String
  soldBy      User                      @relation("SecondarySaleInvoiceSoldBy", fields: [soldById], references: [id])
  customerId  String
  customer    Customer                  @relation("SecondarySaleInvoiceCustomer", fields: [customerId], references: [id])
  totalKobo   BigInt
  paidKobo    BigInt                    @default(0)
  balanceKobo BigInt
  status      SecondaryInvoiceStatus    @default(UNPAID)
  invoiceUrl  String?
  note        String?
  items       SecondarySaleInvoiceItem[]
  payments    SecondaryPayment[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([soldById])
  @@index([customerId])
  @@index([status])
  @@index([soldById, createdAt])
}

model SecondarySaleInvoiceItem {
  id              String               @id @default(uuid())
  invoiceId       String
  invoice         SecondarySaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  quantityCartons Int
  unitPriceKobo   BigInt
  lineTotalKobo   BigInt
  createdAt       DateTime             @default(now())

  @@index([invoiceId])
  @@index([productId])
}

model SecondaryPayment {
  id           String               @id @default(uuid())
  invoiceId    String
  invoice      SecondarySaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User                 @relation("SecondaryPaymentRecorder", fields: [recordedById], references: [id])
  amountKobo   BigInt
  paymentMode  PaymentMode
  note         String?
  createdAt    DateTime             @default(now())
}

model KdLedgerEntry {
  id              String        @id @default(uuid())
  customerId      String
  customer        Customer      @relation("KdLedger", fields: [customerId], references: [id])
  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiptUrl      String?
  totalKobo       BigInt
  paidKobo        BigInt        @default(0)
  balanceKobo     BigInt
  status          LedgerStatus  @default(UNPAID)
  ocrExtracted    Boolean       @default(false)
  note            String?
  payments        KdPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
}

model KdPayment {
  id            String        @id @default(uuid())
  ledgerEntryId String
  ledgerEntry   KdLedgerEntry @relation(fields: [ledgerEntryId], references: [id])
  recordedById  String
  recordedBy    User          @relation("KdPaymentRecorder", fields: [recordedById], references: [id])
  amountKobo    BigInt
  paymentMode   PaymentMode
  note          String?
  createdAt     DateTime      @default(now())

  @@index([ledgerEntryId])
  @@index([recordedById])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 3 — LOCATIONS & TARGETS
// ═════════════════════════════════════════════════════════════════════════════

model Location {
  id        String   @id @default(uuid())
  name      String
  state     String
  region    Region
  createdAt DateTime @default(now())

  customers Customer[]
  targets   LocationTarget[]

  @@unique([name, state])
  @@index([region])
  @@index([state])
}

enum TargetCategory {
  CREAM
  SOAP
  LOTION
  MTN
  SALES
  COLLECTION
}

model LocationTarget {
  id          String         @id @default(uuid())
  locationId  String
  location    Location       @relation(fields: [locationId], references: [id])
  category    TargetCategory
  periodMonth String
  targetValue Int
  createdById String
  createdBy   User           @relation("LocationTargetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([locationId, category, periodMonth])
  @@index([periodMonth])
  @@index([locationId])
}

// ── Agent Inventory ───────────────────────────────────────────────────────────

model AgentInventory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantityCartons Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 3 — COMPETITOR REPORTS
// ═════════════════════════════════════════════════════════════════════════════

model CompetitorReport {
  id            String                    @id @default(uuid())
  submittedById String
  submittedBy   User                      @relation(fields: [submittedById], references: [id])
  region        Region
  state         String?
  mediaType     CompetitorReportMediaType
  mediaUrl      String?
  textContent   String?
  tags          String[]
  createdAt     DateTime                  @default(now())

  @@index([submittedById])
  @@index([region])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 4 — NOTIFICATIONS LOG
// ═════════════════════════════════════════════════════════════════════════════

model Notification {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  title      String
  body       String
  payload    Json                @default("{}")
  sentAt     DateTime?
  failReason String?
  createdAt  DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([channel])
}

model AnalyticsReport {
  id          String   @id @default(uuid())
  periodMonth String   @unique
  pptUrl      String
  xlsxUrl     String
  generatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([periodMonth])
}
